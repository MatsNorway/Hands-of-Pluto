:8px;flex-wrap:wrap;margin-bottom:9px;font-size:12px;color:var(--soft)}.screenrow select{background:#203245;color:var(--text);border:1px solid #405870;border-radius:7px;padding:6px 8px;font:12px system-ui}.edgeIndicator{position:absolute;bottom:9px;right:10px;background:#182e40ba;color:#7df0c6;font:700 10px ui-monospace,monospace;letter-spacing:.03em;padding:4px 6px;border-radius:4px}.edgeIndicator.hit{color:#ffc27c;background:#3b2c20d9}.gameTip{font-size:11px;color:var(--soft);margin:8px 0 0}.log{list-style:none;margin:0;padding:0;max-height:137px;overflow:auto}.log li{font:11px/1.5 ui-monospace,monospace;padding:5px 0;border-top:1px solid #263a4e;color:#bbcede}.log li time{color:#738fa7;margin-right:9px}.below{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:16px}.codein{width:100%;background:#0a1522;color:#baf6d8;border:1px solid #3c5366;border-radius:9px;min-height:76px;resize:vertical;padding:11px 12px;font:12px/1.65 ui-monospace,monospace}.example{font:12px/1.7 ui-monospace,monospace;color:#a4c2d2;background:#0b1622;padding:9px 10px;border-radius:9px;white-space:pre-wrap;overflow:auto;margin:9px 0}.status{font:12px/1.5 ui-monospace,monospace;color:var(--green);min-height:18px;margin-top:8px}.status.error{color:var(--red)}footer{margin-top:17px;color:#8ea5b8;font-size:12px}@media(max-width:880px){.layout,.below{grid-template-columns:1fr}.right{display:grid;grid-template-columns:1fr 1fr}.right .card:last-child{grid-column:1/-1}}@media(max-width:590px){.container{padding:17px 11px 25px}.right{display:flex}.cardbody{padding:13px}header{display:block}.pill{display:inline-flex;margin-top:10px}.pad{max-height:none}.toolrow{gap:7px}.check{margin-left:0;width:100%}.mouse{width:19%;height:35%}}
